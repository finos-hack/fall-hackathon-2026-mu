{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "unique-id": "traderx-006-messaging-nats-replacement",
  "name": "FINOS TraderX — Messaging Layer Replacement with NATS",
  "description": "State 006 replaces Socket.IO trade-feed messaging with NATS while preserving state 005 containerized runtime and ingress entry model.",
  "nodes": [
    {
      "unique-id": "trader",
      "node-type": "actor",
      "name": "Trader Browser",
      "description": "Uses Angular UI and receives live updates."
    },
    {
      "unique-id": "ingress",
      "node-type": "service",
      "name": "NGINX Ingress",
      "description": "Routes REST and websocket traffic.",
      "metadata": {
        "traderx-kind": "gateway"
      }
    },
    {
      "unique-id": "web",
      "node-type": "webclient",
      "name": "Web Front End Angular",
      "description": "Uses nats.ws for account-scoped streams.",
      "metadata": {
        "traderx-kind": "frontend"
      }
    },
    {
      "unique-id": "nats",
      "node-type": "service",
      "name": "NATS Broker",
      "description": "Core pub/sub broker for backend and browser streaming.",
      "metadata": {
        "traderx-kind": "messaging"
      }
    },
    {
      "unique-id": "tradeService",
      "node-type": "service",
      "name": "Trade Service",
      "description": "Publishes new trade events."
    },
    {
      "unique-id": "tradeProcessor",
      "node-type": "service",
      "name": "Trade Processor",
      "description": "Consumes and publishes processed/account updates."
    },
    {
      "unique-id": "account",
      "node-type": "service",
      "name": "Account Service",
      "description": "Account and account-user operations."
    },
    {
      "unique-id": "position",
      "node-type": "service",
      "name": "Position Service",
      "description": "Trades/positions query endpoints."
    },
    {
      "unique-id": "referenceData",
      "node-type": "service",
      "name": "Reference Data",
      "description": "Ticker lookup/list."
    },
    {
      "unique-id": "people",
      "node-type": "service",
      "name": "People Service",
      "description": "Identity lookup and validation."
    },
    {
      "unique-id": "database",
      "node-type": "database",
      "name": "Database",
      "description": "Persistent account/trade/position state."
    }
  ],
  "relationships": [
    {
      "unique-id": "rel-trader-ingress",
      "description": "Single browser entrypoint",
      "relationship-type": {
        "interacts": {
          "actor": "trader",
          "nodes": [
            "ingress"
          ]
        }
      }
    },
    {
      "unique-id": "rel-ingress-web",
      "description": "/",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "ingress"
          },
          "destination": {
            "node": "web"
          }
        }
      }
    },
    {
      "unique-id": "rel-ingress-account",
      "description": "/account-service",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "ingress"
          },
          "destination": {
            "node": "account"
          }
        }
      }
    },
    {
      "unique-id": "rel-ingress-position",
      "description": "/position-service",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "ingress"
          },
          "destination": {
            "node": "position"
          }
        }
      }
    },
    {
      "unique-id": "rel-ingress-tradeService",
      "description": "/trade-service",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "ingress"
          },
          "destination": {
            "node": "tradeService"
          }
        }
      }
    },
    {
      "unique-id": "rel-ingress-referenceData",
      "description": "/reference-data",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "ingress"
          },
          "destination": {
            "node": "referenceData"
          }
        }
      }
    },
    {
      "unique-id": "rel-ingress-people",
      "description": "/people-service",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "ingress"
          },
          "destination": {
            "node": "people"
          }
        }
      }
    },
    {
      "unique-id": "rel-ingress-nats",
      "description": "/nats-ws (WS upgrade)",
      "protocol": "WebSocket",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "ingress"
          },
          "destination": {
            "node": "nats"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeService-account",
      "description": "Validate account",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeService"
          },
          "destination": {
            "node": "account"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeService-referenceData",
      "description": "Validate ticker",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeService"
          },
          "destination": {
            "node": "referenceData"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeService-nats",
      "description": "Publish trades.new",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeService"
          },
          "destination": {
            "node": "nats"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeProcessor-nats",
      "description": "Consume trades.new, publish account updates",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeProcessor"
          },
          "destination": {
            "node": "nats"
          }
        }
      }
    },
    {
      "unique-id": "rel-web-nats",
      "description": "Subscribe account-scoped streams",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web"
          },
          "destination": {
            "node": "nats"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeProcessor-database",
      "description": "Persist trade/position state",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeProcessor"
          },
          "destination": {
            "node": "database"
          }
        }
      }
    },
    {
      "unique-id": "rel-account-database",
      "description": "Account persistence",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "account"
          },
          "destination": {
            "node": "database"
          }
        }
      }
    },
    {
      "unique-id": "rel-position-database",
      "description": "Query trades/positions",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "position"
          },
          "destination": {
            "node": "database"
          }
        }
      }
    },
    {
      "unique-id": "rel-account-people",
      "description": "Validate person",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "account"
          },
          "destination": {
            "node": "people"
          }
        }
      }
    }
  ],
  "metadata": {
    "source-project": "finos/traderx",
    "state-id": "006-messaging-nats-replacement",
    "track": "architecture",
    "status": "implemented",
    "inherits-from": "005-postgres-database-replacement",
    "notes": [
      "State 006 is an architecture-track branch from state 005.",
      "Messaging transport changes to NATS; business behavior remains baseline-compatible.",
      "JetStream durability is intentionally deferred to a future state."
    ]
  },
  "adrs": [
    "docs/adr/005-state-006-use-nats-for-messaging-replacement.md"
  ]
}
