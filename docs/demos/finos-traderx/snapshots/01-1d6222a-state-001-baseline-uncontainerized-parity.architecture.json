{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "unique-id": "traderx-001-baseline-uncontainerized-parity",
  "name": "FINOS TraderX — Simple App - Base Uncontainerized App",
  "description": "Baseline pre-containerized architecture with direct browser-to-service calls and Socket.IO trade/position subscriptions.",
  "nodes": [
    {
      "unique-id": "trader",
      "node-type": "actor",
      "name": "Trader Browser",
      "description": "Human user interacting with Angular UI."
    },
    {
      "unique-id": "web",
      "node-type": "webclient",
      "name": "Web Front End Angular",
      "description": "Browser-hosted UI.",
      "metadata": {
        "traderx-kind": "frontend"
      }
    },
    {
      "unique-id": "account",
      "node-type": "service",
      "name": "Account Service",
      "description": "Account and account-user CRUD."
    },
    {
      "unique-id": "position",
      "node-type": "service",
      "name": "Position Service",
      "description": "Trades and positions query endpoints."
    },
    {
      "unique-id": "tradeService",
      "node-type": "service",
      "name": "Trade Service",
      "description": "Trade submission and validation."
    },
    {
      "unique-id": "referenceData",
      "node-type": "service",
      "name": "Reference Data",
      "description": "Ticker lookup/list."
    },
    {
      "unique-id": "people",
      "node-type": "service",
      "name": "People Service",
      "description": "Directory lookup and validation."
    },
    {
      "unique-id": "tradeFeed",
      "node-type": "service",
      "name": "Trade Feed",
      "description": "Socket.IO publish/subscribe bus.",
      "metadata": {
        "traderx-kind": "messaging"
      }
    },
    {
      "unique-id": "tradeProcessor",
      "node-type": "service",
      "name": "Trade Processor",
      "description": "Processes new trades and updates positions."
    },
    {
      "unique-id": "database",
      "node-type": "database",
      "name": "Database",
      "description": "Persistent account, trade, and position state."
    }
  ],
  "relationships": [
    {
      "unique-id": "rel-trader-web",
      "description": "Uses UI",
      "relationship-type": {
        "interacts": {
          "actor": "trader",
          "nodes": [
            "web"
          ]
        }
      }
    },
    {
      "unique-id": "rel-web-account",
      "description": "REST /account + /accountuser",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web"
          },
          "destination": {
            "node": "account"
          }
        }
      }
    },
    {
      "unique-id": "rel-web-position",
      "description": "REST /trades + /positions",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web"
          },
          "destination": {
            "node": "position"
          }
        }
      }
    },
    {
      "unique-id": "rel-web-tradeService",
      "description": "REST /trade",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web"
          },
          "destination": {
            "node": "tradeService"
          }
        }
      }
    },
    {
      "unique-id": "rel-web-referenceData",
      "description": "REST /stocks",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web"
          },
          "destination": {
            "node": "referenceData"
          }
        }
      }
    },
    {
      "unique-id": "rel-web-people",
      "description": "REST /People",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web"
          },
          "destination": {
            "node": "people"
          }
        }
      }
    },
    {
      "unique-id": "rel-web-tradeFeed",
      "description": "Socket.IO subscribe",
      "protocol": "SocketIO",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web"
          },
          "destination": {
            "node": "tradeFeed"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeService-account",
      "description": "Validate account",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeService"
          },
          "destination": {
            "node": "account"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeService-referenceData",
      "description": "Validate ticker",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeService"
          },
          "destination": {
            "node": "referenceData"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeService-tradeFeed",
      "description": "Publish trades/new",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeService"
          },
          "destination": {
            "node": "tradeFeed"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeProcessor-tradeFeed",
      "description": "Consume and publish updates",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeProcessor"
          },
          "destination": {
            "node": "tradeFeed"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeProcessor-database",
      "description": "Persist trade/position state",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeProcessor"
          },
          "destination": {
            "node": "database"
          }
        }
      }
    },
    {
      "unique-id": "rel-account-people",
      "description": "Validate person for account-user mapping",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "account"
          },
          "destination": {
            "node": "people"
          }
        }
      }
    },
    {
      "unique-id": "rel-account-database",
      "description": "Account persistence",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "account"
          },
          "destination": {
            "node": "database"
          }
        }
      }
    },
    {
      "unique-id": "rel-position-database",
      "description": "Query trades/positions",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "position"
          },
          "destination": {
            "node": "database"
          }
        }
      }
    }
  ],
  "metadata": {
    "source-project": "finos/traderx",
    "state-id": "001-baseline-uncontainerized-parity",
    "track": "prelude",
    "status": "released",
    "notes": [
      "This state is intentionally pre-ingress and cross-origin.",
      "CORS behavior is part of baseline non-functional requirements."
    ]
  },
  "adrs": [
    "docs/adr/001-adopt-github-speckit.md",
    "docs/adr/002-generated-state-branching-strategy.md",
    "docs/adr/003-baseline-intentionally-simplistic-legacy-shaped.md"
  ]
}
