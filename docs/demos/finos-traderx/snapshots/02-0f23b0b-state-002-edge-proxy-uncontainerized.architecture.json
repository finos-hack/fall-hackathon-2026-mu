{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "unique-id": "traderx-002-edge-proxy-uncontainerized",
  "name": "FINOS TraderX — Edge Proxy Uncontainerized",
  "description": "State 002 keeps uncontainerized services and introduces an edge proxy as the single browser-facing entrypoint.",
  "nodes": [
    {
      "unique-id": "trader",
      "node-type": "actor",
      "name": "Trader Browser",
      "description": "User enters only through edge proxy."
    },
    {
      "unique-id": "edge",
      "node-type": "service",
      "name": "Edge Proxy",
      "description": "Single browser-facing origin.",
      "metadata": {
        "traderx-kind": "gateway"
      }
    },
    {
      "unique-id": "web",
      "node-type": "webclient",
      "name": "Web Front End Angular",
      "description": "Served behind edge proxy.",
      "metadata": {
        "traderx-kind": "frontend"
      }
    },
    {
      "unique-id": "account",
      "node-type": "service",
      "name": "Account Service",
      "description": "Account and account-user CRUD."
    },
    {
      "unique-id": "position",
      "node-type": "service",
      "name": "Position Service",
      "description": "Trades and positions query endpoints."
    },
    {
      "unique-id": "tradeService",
      "node-type": "service",
      "name": "Trade Service",
      "description": "Trade submission and validation."
    },
    {
      "unique-id": "referenceData",
      "node-type": "service",
      "name": "Reference Data",
      "description": "Ticker lookup/list."
    },
    {
      "unique-id": "people",
      "node-type": "service",
      "name": "People Service",
      "description": "Directory lookup and validation."
    },
    {
      "unique-id": "tradeFeed",
      "node-type": "service",
      "name": "Trade Feed",
      "description": "Socket.IO publish/subscribe bus.",
      "metadata": {
        "traderx-kind": "messaging"
      }
    },
    {
      "unique-id": "tradeProcessor",
      "node-type": "service",
      "name": "Trade Processor",
      "description": "Processes new trades and updates positions."
    },
    {
      "unique-id": "database",
      "node-type": "database",
      "name": "Database",
      "description": "Persistent account, trade, and position state."
    }
  ],
  "relationships": [
    {
      "unique-id": "rel-trader-edge",
      "description": "Single browser entrypoint",
      "relationship-type": {
        "interacts": {
          "actor": "trader",
          "nodes": [
            "edge"
          ]
        }
      }
    },
    {
      "unique-id": "rel-edge-web",
      "description": "/",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "edge"
          },
          "destination": {
            "node": "web"
          }
        }
      }
    },
    {
      "unique-id": "rel-edge-account",
      "description": "/account-service",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "edge"
          },
          "destination": {
            "node": "account"
          }
        }
      }
    },
    {
      "unique-id": "rel-edge-position",
      "description": "/position-service",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "edge"
          },
          "destination": {
            "node": "position"
          }
        }
      }
    },
    {
      "unique-id": "rel-edge-tradeService",
      "description": "/trade-service",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "edge"
          },
          "destination": {
            "node": "tradeService"
          }
        }
      }
    },
    {
      "unique-id": "rel-edge-referenceData",
      "description": "/reference-data",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "edge"
          },
          "destination": {
            "node": "referenceData"
          }
        }
      }
    },
    {
      "unique-id": "rel-edge-people",
      "description": "/people-service",
      "protocol": "HTTP",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "edge"
          },
          "destination": {
            "node": "people"
          }
        }
      }
    },
    {
      "unique-id": "rel-edge-tradeFeed",
      "description": "/socket.io",
      "protocol": "SocketIO",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "edge"
          },
          "destination": {
            "node": "tradeFeed"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeService-account",
      "description": "Validate account",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeService"
          },
          "destination": {
            "node": "account"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeService-referenceData",
      "description": "Validate ticker",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeService"
          },
          "destination": {
            "node": "referenceData"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeService-tradeFeed",
      "description": "Publish trades/new",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeService"
          },
          "destination": {
            "node": "tradeFeed"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeProcessor-tradeFeed",
      "description": "Consume and publish updates",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeProcessor"
          },
          "destination": {
            "node": "tradeFeed"
          }
        }
      }
    },
    {
      "unique-id": "rel-tradeProcessor-database",
      "description": "Persist trade/position state",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tradeProcessor"
          },
          "destination": {
            "node": "database"
          }
        }
      }
    },
    {
      "unique-id": "rel-account-people",
      "description": "Validate person for account-user mapping",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "account"
          },
          "destination": {
            "node": "people"
          }
        }
      }
    },
    {
      "unique-id": "rel-account-database",
      "description": "Account persistence",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "account"
          },
          "destination": {
            "node": "database"
          }
        }
      }
    },
    {
      "unique-id": "rel-position-database",
      "description": "Query trades/positions",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "position"
          },
          "destination": {
            "node": "database"
          }
        }
      }
    }
  ],
  "metadata": {
    "source-project": "finos/traderx",
    "state-id": "002-edge-proxy-uncontainerized",
    "track": "prelude",
    "status": "implemented",
    "inherits-from": "001-baseline-uncontainerized-parity",
    "notes": [
      "State 002 preserves baseline functional flows F1-F6.",
      "Primary delta is topology and origin model, not business behavior."
    ]
  }
}
