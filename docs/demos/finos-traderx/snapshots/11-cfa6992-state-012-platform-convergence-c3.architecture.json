{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "unique-id": "traderx-012-platform-convergence-c3",
  "name": "FINOS TraderX — Platform Convergence C3",
  "description": "State 012 is the C3 convergence checkpoint: Kubernetes + Tilt platform profile on top of C2 functional behavior.",
  "nodes": [
    {
      "unique-id": "developer",
      "node-type": "actor",
      "name": "Developer",
      "description": "Iterates locally with fast feedback loops."
    },
    {
      "unique-id": "tilt",
      "node-type": "service",
      "name": "Tilt Dev Loop",
      "description": "Build/deploy/log orchestration for local k8s.",
      "metadata": {
        "traderx-kind": "tooling"
      }
    },
    {
      "unique-id": "cluster",
      "node-type": "network",
      "name": "Kubernetes Cluster",
      "description": "Underlying runtime substrate inherited from state 011.",
      "metadata": {
        "traderx-kind": "boundary"
      }
    },
    {
      "unique-id": "edge",
      "node-type": "service",
      "name": "NGINX Edge Proxy",
      "description": "Single browser/API entrypoint.",
      "metadata": {
        "traderx-kind": "gateway"
      }
    },
    {
      "unique-id": "workloads",
      "node-type": "service",
      "name": "TraderX Workloads",
      "description": "Core services remain functionally equivalent to state 009 (C2), carried through state 012 lineage."
    }
  ],
  "relationships": [
    {
      "unique-id": "rel-developer-tilt",
      "description": "Runs tilt up",
      "relationship-type": {
        "interacts": {
          "actor": "developer",
          "nodes": [
            "tilt"
          ]
        }
      }
    },
    {
      "unique-id": "rel-tilt-cluster",
      "description": "Applies k8s resources",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "tilt"
          },
          "destination": {
            "node": "cluster"
          }
        }
      }
    },
    {
      "unique-id": "rel-cluster-edge",
      "description": "Runs ingress",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "cluster"
          },
          "destination": {
            "node": "edge"
          }
        }
      }
    },
    {
      "unique-id": "rel-edge-workloads",
      "description": "Routes UI/API/WebSocket traffic",
      "protocol": "WebSocket",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "edge"
          },
          "destination": {
            "node": "workloads"
          }
        }
      }
    }
  ],
  "metadata": {
    "source-project": "finos/traderx",
    "state-id": "012-platform-convergence-c3",
    "track": "devex",
    "status": "implemented",
    "inherits-from": "011-tilt-kubernetes-dev-loop",
    "notes": [
      "Publish lineage parent is state 011.",
      "Dotted-line convergence parent is state 009 (C2 functional convergence).",
      "State 012 marks C3 and is the recommended platform-ready baseline for subsequent work."
    ]
  },
  "adrs": [
    "docs/adr/008-convergence-state-model.md"
  ]
}
