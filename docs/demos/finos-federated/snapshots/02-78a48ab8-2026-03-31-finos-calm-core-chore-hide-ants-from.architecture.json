{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "nodes": [
    {
      "unique-id": "finos-calm-core--calm-user",
      "node-type": "actor",
      "name": "CALM User",
      "description": "User working with CALM architectures through various tools and interfaces"
    },
    {
      "unique-id": "finos-calm-core--calm-cli",
      "node-type": "service",
      "name": "CALM CLI",
      "description": "Command-line interface for CALM operations including validation, generation, visualization, and documentation",
      "development-language": "TypeScript"
    },
    {
      "unique-id": "finos-calm-core--calm-vscode",
      "node-type": "service",
      "name": "VSCode Extension",
      "description": "Visual Studio Code extension providing IDE integration for CALM architectures with syntax highlighting, validation, and visualization",
      "development-language": "TypeScript"
    },
    {
      "unique-id": "finos-calm-core--calm-hub",
      "node-type": "service",
      "name": "CALM Hub API",
      "description": "Central registry and API service for CALM architectures, patterns, and standards built with Quarkus",
      "development-language": "Java",
      "interfaces": [
        {
          "unique-id": "finos-calm-core--calm-hub-rest-api",
          "type": "api"
        }
      ]
    },
    {
      "unique-id": "finos-calm-core--calm-hub-ui",
      "node-type": "system",
      "name": "CALM Hub UI",
      "description": "React-based web interface for browsing and managing CALM architectures, patterns, and standards",
      "development-language": "TypeScript"
    },
    {
      "unique-id": "finos-calm-core--mongodb",
      "node-type": "database",
      "name": "MongoDB",
      "description": "Document database for storing CALM architectures, patterns, and standards in CALM Hub",
      "interfaces": [
        {
          "unique-id": "finos-calm-core--mongodb-port",
          "type": "port-interface",
          "port": 27017
        }
      ]
    },
    {
      "unique-id": "finos-calm-core--calm-hub-system",
      "node-type": "system",
      "name": "CALM Hub System",
      "description": "Complete CALM Hub system including API backend, web UI, and database"
    },
    {
      "unique-id": "finos-calm-core--vscode",
      "node-type": "system",
      "name": "Visual Studio Code",
      "description": "Microsoft Visual Studio Code IDE"
    }
  ],
  "relationships": [
    {
      "unique-id": "finos-calm-core--user-interacts-with-ui",
      "description": "CALM user interacts with CALM Hub UI through web browser",
      "relationship-type": {
        "interacts": {
          "actor": "finos-calm-core--calm-user",
          "nodes": [
            "finos-calm-core--calm-hub-ui"
          ]
        }
      }
    },
    {
      "unique-id": "finos-calm-core--user-interacts-with-cli",
      "description": "CALM user interacts with CALM CLI through command line",
      "relationship-type": {
        "interacts": {
          "actor": "finos-calm-core--calm-user",
          "nodes": [
            "finos-calm-core--calm-cli"
          ]
        }
      }
    },
    {
      "unique-id": "finos-calm-core--user-interacts-with-vscode",
      "description": "CALM user interacts with VSCode extension through IDE",
      "relationship-type": {
        "interacts": {
          "actor": "finos-calm-core--calm-user",
          "nodes": [
            "finos-calm-core--calm-vscode"
          ]
        }
      }
    },
    {
      "unique-id": "finos-calm-core--cli-to-hub",
      "description": "CLI interacts with CALM Hub API REST endpoint for publishing and retrieving architectures",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "finos-calm-core--calm-cli"
          },
          "destination": {
            "node": "finos-calm-core--calm-hub",
            "interface": "finos-calm-core--calm-hub-rest-api"
          }
        }
      },
      "protocol": "HTTPS"
    },
    {
      "unique-id": "finos-calm-core--hub-to-db",
      "description": "CALM Hub API stores and retrieves data from MongoDB",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "finos-calm-core--calm-hub"
          },
          "destination": {
            "node": "finos-calm-core--mongodb",
            "interface": "finos-calm-core--mongodb-port"
          }
        }
      },
      "protocol": "TCP"
    },
    {
      "unique-id": "finos-calm-core--hub-ui-to-hub",
      "description": "CALM Hub UI interacts with CALM Hub API via REST endpoint",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "finos-calm-core--calm-hub-ui"
          },
          "destination": {
            "node": "finos-calm-core--calm-hub",
            "interface": "finos-calm-core--calm-hub-rest-api"
          }
        }
      },
      "protocol": "HTTPS"
    },
    {
      "unique-id": "finos-calm-core--hub-system-composition",
      "description": "CALM Hub System is composed of API backend, web UI, and database",
      "relationship-type": {
        "composed-of": {
          "container": "finos-calm-core--calm-hub-system",
          "nodes": [
            "finos-calm-core--calm-hub",
            "finos-calm-core--calm-hub-ui",
            "finos-calm-core--mongodb"
          ]
        }
      }
    },
    {
      "unique-id": "finos-calm-core--vscode-composition",
      "description": "VSCode contains the CALM extension",
      "relationship-type": {
        "deployed-in": {
          "container": "finos-calm-core--vscode",
          "nodes": [
            "finos-calm-core--calm-vscode"
          ]
        }
      }
    }
  ],
  "flows": [
    {
      "unique-id": "finos-calm-core--flow-publish-architecture",
      "name": "[FINOS CALM Core] Publish Architecture",
      "description": "User authors and publishes a CALM architecture to the Hub via the CLI",
      "transitions": [
        {
          "relationship-unique-id": "finos-calm-core--user-interacts-with-cli",
          "sequence-number": 1,
          "description": "User invokes the CLI to publish an architecture"
        },
        {
          "relationship-unique-id": "finos-calm-core--cli-to-hub",
          "sequence-number": 2,
          "description": "CLI sends the architecture to the CALM Hub API over HTTPS"
        },
        {
          "relationship-unique-id": "finos-calm-core--hub-to-db",
          "sequence-number": 3,
          "description": "CALM Hub API persists the architecture in MongoDB"
        }
      ]
    },
    {
      "unique-id": "finos-calm-core--flow-browse-architectures",
      "name": "[FINOS CALM Core] Browse Architectures",
      "description": "User browses published architectures through the CALM Hub web UI",
      "transitions": [
        {
          "relationship-unique-id": "finos-calm-core--user-interacts-with-ui",
          "sequence-number": 1,
          "description": "User opens the CALM Hub UI in a browser"
        },
        {
          "relationship-unique-id": "finos-calm-core--hub-ui-to-hub",
          "sequence-number": 2,
          "description": "Hub UI fetches architecture data from the Hub API"
        },
        {
          "relationship-unique-id": "finos-calm-core--hub-to-db",
          "sequence-number": 3,
          "description": "Hub API queries MongoDB for stored architectures"
        }
      ]
    },
    {
      "unique-id": "finos-calm-core--flow-validate-in-ide",
      "name": "[FINOS CALM Core] Validate Architecture in IDE",
      "description": "User validates a CALM architecture directly inside VS Code using the extension",
      "transitions": [
        {
          "relationship-unique-id": "finos-calm-core--user-interacts-with-vscode",
          "sequence-number": 1,
          "description": "User opens a CALM file in VS Code and triggers validation"
        }
      ]
    }
  ]
}
